{
  "name": "qa-framework",
  "version": "0.1.0",
  "description": "Enterprise test framework for the Support Portal (black-box API + UI testing, feature registry, feature-wise reporting)",
  "private": true,
  "type": "module",
  "bin": {
    "qa": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "qa": "tsx src/cli.ts",
    "qa:list": "tsx src/cli.ts list",
    "qa:validate": "tsx src/cli.ts validate",
    "qa:run": "tsx src/cli.ts run",
    "gen:matrix": "tsx scripts/generate-automation-matrix.ts",
    "test": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "nodemailer": "^6.9.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^6.4.15",
    "eslint": "^9.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}