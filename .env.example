# qa-framework environment contract.
# Copy to .env.local / .env.ci / .env.staging and fill in per-environment values.

QA_ENV=local
QA_BASE_URL=http://localhost:3000
QA_ADMIN_EMAIL=admin@e2e.test
QA_ADMIN_PASSWORD=Password123!
# NOTE: local stacks seeded via scripts/quick-fresh-setup.sh use
#   admin@mycompany.com / Admin123!  (put those in .env.local)
QA_AGENT_EMAIL=agent@e2e.test
QA_AGENT_PASSWORD=Password123!
QA_LIMITED_EMAIL=limited@e2e.test
QA_LIMITED_PASSWORD=Password123!
QA_GIT_SHA=unknown
# Required for any test run that creates/changes product data outside local/CI.
# Never enable this against production.
QA_ALLOW_DESTRUCTIVE=false

# Service base URLs (defaults to localhost:<port>).
QA_SESSION_SERVICE_URL=http://localhost:4015
QA_TICKET_SERVICE_URL=http://localhost:4006
QA_AUTOMATION_SERVICE_URL=http://localhost:4010
QA_QUEUE_SERVICE_URL=http://localhost:4013
QA_ROUTING_SERVICE_URL=http://localhost:4014
QA_TENANT_SERVICE_URL=http://localhost:4005
QA_FAQ_SERVICE_URL=http://localhost:4018
QA_TAG_SERVICE_URL=http://localhost:4016
QA_WEBSOCKET_GATEWAY_SERVICE_URL=http://localhost:4017
QA_WS_URL=ws://localhost:4017

# Optional direct DB access.
# QA_DB_HOST=localhost
# QA_DB_PORT=15432
# QA_DB_USER=support
# QA_DB_PASSWORD=support
# QA_DB_NAME=supportdb

# Reporting + notifications.
QA_REPORT_DIR=reports
QA_NOTIFY=on-failure
QA_EMAIL_ENABLED=false
QA_EMAIL_TRANSPORT=smtp
QA_EMAIL_FROM=qa-bot@company.com
QA_EMAIL_TO=qa-team@company.com
# QA_SMTP_HOST=smtp.company.com
# QA_SMTP_PORT=587
# QA_SMTP_USER=
# QA_SMTP_PASS=
# QA_SMTP_SECURE=false
# QA_SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/yyy/zzz

# Webchat (optional): enables the real POST /api/webchat/sessions boot check in
# the webchat-automation feature. Without these, that check is skipped.
# QA_WEBCHAT_DOMAIN_ID=testcompany_domain_0201a580fcd6436db115d0a96f56f873
# QA_WEBCHAT_PLATFORM_ID=
# QA_WEBCHAT_APP_ID=
#
# REQUIRED for ticket-creating features (tickets, automation, webchat-automation):
# the ticket create API validates platform_id + app_id, and GET /api/platforms
# returns only {type, name} (no ids), so both ids must be configured per env:
# QA_WEBCHAT_DOMAIN_ID=mydomain_domain_26b7b5de047848738f2cde1691044898
# QA_WEBCHAT_PLATFORM_ID=mydomain_platform_4dde113a-69c88eb2-c2150db7-e537a288
# QA_WEBCHAT_APP_ID=mydomain_app_284a857a2de871b3bbde61c2fb6a4a7a

# UI runner
QA_HEADLESS=true
QA_WORKERS=1
